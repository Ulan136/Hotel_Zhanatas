# Строка подключения к базе Neon Postgres.
# Neon → ваш проект → Connection Details → скопируйте "Connection string" (с ?sslmode=require).
# На Vercel эта переменная задаётся в Project → Settings → Environment Variables.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
